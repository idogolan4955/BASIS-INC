{
  "hosting": [
    {
      "target": "web",
      "public": "apps/web/build/client",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "cleanUrls": true,
      "headers": [
        {
          "source": "**",
          "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
        },
        {
          "source": "/assets/**/*.@(js|css|woff|woff2|png|jpg|jpeg|webp|avif|svg|mp4|webm|map)",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
        }
      ]
    },
    {
      "target": "platform",
      "public": "apps/platform/dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [{ "source": "**", "destination": "/index.html" }],
      "headers": [
        {
          "source": "**",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, must-revalidate" },
            { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
          ]
        },
        {
          "source": "/assets/**/*.@(js|css|woff|woff2|png|jpg|jpeg|webp|avif|svg|map)",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
        }
      ]
    }
  ],
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": { "port": 9099 },
    "storage": { "port": 9199 },
    "ui": { "enabled": true, "port": 4000 }
  }
}
