{
  "name": "@basis/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./dataconnect/platform": {
      "types": "./src/dataconnect-generated/platform/index.d.ts",
      "import": "./src/dataconnect-generated/platform/esm/index.esm.js",
      "default": "./src/dataconnect-generated/platform/index.cjs.js"
    },
    "./dataconnect/public": {
      "types": "./src/dataconnect-generated/public/index.d.ts",
      "import": "./src/dataconnect-generated/public/esm/index.esm.js",
      "default": "./src/dataconnect-generated/public/index.cjs.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "firebase": "^12.19.0"
  }
}
